# =============================================================================
# Rust Server Monitor Bot - .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Переменные окружения и конфигурация
# -----------------------------------------------------------------------------
.env
*.env
.env.*
!.env.example

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
# Кэш и скомпилированные файлы
__pycache__/
*.py[cod]
*$py.class
*.so

# Виртуальные окружения
venv/
env/
ENV/
.venv
.ENV
env.bak/
venv.bak/

# Распределение / упаковка
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# -----------------------------------------------------------------------------
# База данных
# -----------------------------------------------------------------------------
# SQL файлы (кроме схем в sql/)
*.sql
!sql/**/*.sql

# Файлы резервных копий БД
backups/
*.bak

# Модели баз данных
*.mwb

# -----------------------------------------------------------------------------
# Логи
# -----------------------------------------------------------------------------
logs/
log/
*.log

# -----------------------------------------------------------------------------
# Данные и конфигурация
# -----------------------------------------------------------------------------
# JSON файлы с данными (генерируемые файлы)
jsons/all_servers.json
jsons/all_servers_fixed.json
jsons/servers_id_map.json
# Оставляем другие JSON файлы (примеры данных можно коммитить)

# Папка с заметками
txts/

# Папка с фото для помощи пользователям
user_help_photos/

# -----------------------------------------------------------------------------
# IDE и редакторы
# -----------------------------------------------------------------------------
# Visual Studio Code
.vscode/
*.code-workspace

# PyCharm / IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.vim/

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

